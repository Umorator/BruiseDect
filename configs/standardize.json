{
  "sources": [
    "data/raw_data/forensic_annotations/doc1",
    "data/raw_data/forensic_annotations/doc2",
    "data/raw_data/forensic_annotations/doc3"
  ],
  "images_roots": [
    "data/raw_data/forensic_annotations/doc1"
  ],
  "output_root": "data/raw_data/Standards",
  "options": {
    "write_drawn": true,
    "copy_uncommon_images": true,
    "class_id": 0,
    "valid_exts": [".jpg", ".jpeg", ".png"]
  },
  "params": {
    "strict": {
      "iou_threshold": 0.05,
      "containment_threshold": 0.8,
      "min_overlap_ratio": 0.20,
      "nms_iou": 0.20
    },
    "smoothed": {
      "iou_threshold": 0.05,
      "min_overlap_ratio": 0.20,
      "nms_iou": 0.20
    },
    "loose": {
      "iou_threshold": 0.05,
      "containment_threshold_full": 1.0,
      "nms_iou": 0.20
    }
  }
}