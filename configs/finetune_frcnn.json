{
  "strategy": "strict",

  "aug_root": "data/augmented_ft",
  "project_dir": "outputs/training_ft/{strategy}/FRCNN",
  "out_dir": "outputs/training_ft/{strategy}/FRCNN",

  "resize_number": 640,
  "batch": 4,
  "workers": 16,

  "epochs": 15,
  "lr": 0.0003,
  "lrf": 0.01,

  "use_dropout": false,
  "dropout_prob": 0.0,
  "weight_decay": 0.01,
  "pretrained": true,
  "trainable_backbone_layers": 2,

  "init_from_prev": true,
  "prev_weights_template": "outputs/training/{strategy}/FRCNN/k{fold}/best_model.pth",

  "device": null
}